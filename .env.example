# 新版配置；不预置网页登录密码或第三方 API 密钥。
# 使用独立数据目录；不指向旧版数据库或附件目录。
MEOW_HOST=127.0.0.1
MEOW_PORT=3000
MEOW_DATA_DIR=./data-v2
MEOW_STATIC_DIR=./build

# 网页登录密码：取消下一行注释，填写自己的非空密码后重启后端，长度自定。
# 未设置或留空时仅可公开浏览，不能登录。
# MEOW_OWNER_PASSWORD=
MEOW_SESSION_TTL_MS=604800000
MEOW_TRUST_PROXY=false

# 生产环境使用 HTTPS origin，如 https://notes.example.com（不含路径）。
MEOW_PUBLIC_ORIGIN=

# 可选 AI 集成：三个字段同时填写后启用。
# MEOW_AI_API_KEY 是 AI 服务商密钥，与网页登录密码无关；只在本机 .env 中填写。
MEOW_AI_BASE_URL=
MEOW_AI_API_KEY=
MEOW_AI_MODEL=

# 下列集成采用服务端默认地址；将对应值留空可关闭该集成。
MEOW_MUSIC_SEARCH_URL=https://api.kxzjoker.cn/api/163_search
MEOW_MUSIC_RESOLVE_URL=https://api.kxzjoker.cn/api/163_music
MEOW_BACKGROUND_URL=https://imgapi.xl0408.top/index.php
MEOW_HITOKOTO_URL=https://v1.hitokoto.cn/

# Docker 宿主机端口；容器内部端口由镜像固定为 3000。
# MEOW_HTTP_PORT=3000

# 可选：由运维指定DNS服务器，逗号分隔；默认使用系统解析，仍拒绝所有私网/保留IP答案。
# Fake-IP代理可能拦截DNS；本项不能绕过安全校验，也不修改系统配置。
MEOW_DNS_SERVERS=
