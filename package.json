{
  "name": "meow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "自部署的笔记、画布与回顾工作区",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:local": "concurrently --kill-others --names api,web \"npm run server:dev\" \"npm run dev\"",
    "server:dev": "tsx watch server/main.ts",
    "server": "node dist/server/main.js",
    "start": "node dist/server/main.js",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server shared tests vite.config.ts vitest.config.ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "html2canvas": "1.4.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "0.417.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.22",
    "concurrently": "^9.2.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "postcss": "^8.5.6",
    "supertest": "^7.1.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "postcss-nested": "7.0.2"
  }
}
